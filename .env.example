# Copy to `.env` and fill in values: cp .env.example .env
# `.env` is gitignored; never commit real secrets. Every variable is validated
# at startup by `src/config.ts`.

# development | test | production
NODE_ENV=development

# Port the HTTP server listens on
PORT=3000

# Minimum log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Database connection: postgres://user:password@host:port/database
# Docker (`docker compose up -d`): postgres://champions:champions@localhost:5432/champions
# Postgres.app: postgres://<your Mac username>@localhost:5432/champions (no password; run `createdb champions` once)
DATABASE_URL=postgres://champions:champions@localhost:5432/champions
